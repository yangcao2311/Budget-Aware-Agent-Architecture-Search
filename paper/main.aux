\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Breakage of the incumbent-protecting workflow across verifier regimes and domains. The guarantee tracks verifier signal, not domain. The single violation is the one condition without signal, and restoring signal on the \emph  {same tasks} restores the guarantee.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:regimes}{{2}{6}{Breakage of the incumbent-protecting workflow across verifier regimes and domains. The guarantee tracks verifier signal, not domain. The single violation is the one condition without signal, and restoring signal on the \emph {same tasks} restores the guarantee}{table.2}{}}

\@writefile{toc}{\contentsline {paragraph}{A locked prediction that failed.}{6}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Diagnosis: our confound, not the framework's.}{6}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Decoupling.}{6}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: degrading the verifier is a causal manipulation of the breakage term. As visible tests are withheld, breakage rises and the net effect falls to $-0.118$ $[-0.178,-0.058]$. Right: breakage of the incumbent-protecting construction across every condition we measured. It stays below the predicted bound wherever the verifier carries signal --- including out of domain, and in a third domain whose prediction was locked before execution --- and exceeds it in exactly the one condition with no signal. Restoring signal on the \emph  {same} tasks restores the guarantee.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:signal}{{2}{7}{Left: degrading the verifier is a causal manipulation of the breakage term. As visible tests are withheld, breakage rises and the net effect falls to $-0.118$ $[-0.178,-0.058]$. Right: breakage of the incumbent-protecting construction across every condition we measured. It stays below the predicted bound wherever the verifier carries signal --- including out of domain, and in a third domain whose prediction was locked before execution --- and exceeds it in exactly the one condition with no signal. Restoring signal on the \emph {same} tasks restores the guarantee}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Prospective validation on BIG-Bench Hard (120 tasks, 3 seeds), a domain untouched by any search, tuning or exploratory run. Predictions were locked before execution. This is a demanding regime: the baseline is strong ($p=0.919$--$0.944$), so the threshold of equation~\ref {eq:rule} is only $(1-p)/p = 0.088$ and even small breakage should flip the sign.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:prospective}{{3}{7}{Prospective validation on BIG-Bench Hard (120 tasks, 3 seeds), a domain untouched by any search, tuning or exploratory run. Predictions were locked before execution. This is a demanding regime: the baseline is strong ($p=0.919$--$0.944$), so the threshold of \eqref {eq:rule} is only $(1-p)/p = 0.088$ and even small breakage should flip the sign}{table.3}{}}
